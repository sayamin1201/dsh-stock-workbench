{
  "name": "dsh-stock-workbench",
  "version": "0.1.2",
  "type": "module",
  "description": "看股工作台：全 A 股今日快照、多指标排序与条件选股。A-share market workbench: today's full-market snapshot with multi-metric ranking and screening.",
  "icon": "icon.svg",
  "keywords": [
    "dsh-plugin",
    "stock",
    "a-share",
    "market",
    "screener"
  ],
  "license": "MIT",
  "author": "sayamin1201",
  "homepage": "https://github.com/sayamin1201/dsh-stock-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayamin1201/dsh-stock-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/sayamin1201/dsh-stock-workbench/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./market": "./lib/market.js",
    "./query": "./lib/query.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
